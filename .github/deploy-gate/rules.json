    "\\bEngine\\.(get_singleton|register_singleton)",
    "\\bClassDB\\b",
    "\\b(GDScript|CSharpScript)\\.new\\b",
    "\\b(source_code|set_script|reload)\\b",
    "\\.(call|callv|call_deferred|callv_deferred|rpc_config)\\(",
    "\\bCallable\\(",
    "\\b(DirAccess|FileAccess)\\.open\\([^)]*(\"(/|[A-Za-z]:)|OS\\.)"
